{
  "unetic": {
    "description": "Access the Unetic control plane",
    "read": {
      "ubus": {
        "unetic": [
          "state",
          "wifi.get",
          "wan.get",
          "switch.get",
          "system.info",
          "devices.list",
          "operation.get",
          "maintenance.get",
          "health.get",
          "tools.ping",
          ":subscribe"
        ]
      }
    },
    "write": {
      "ubus": {
        "unetic": [
          "wifi.set_config",
          "wan.set",
          "wan.set_config",
          "maintenance.enter",
          "maintenance.exit"
        ]
      }
    }
  }
}
